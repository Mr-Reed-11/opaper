{
  "schema_version": 1,
  "name": "Plasma Waves",
  "author": "opaper",
  "version": "0.1.0",
  "description": "Ondas de plasma em tela cheia (exemplo do milestone 1).",
  "type": "shader",
  "shader": "shader.frag",
  "params": {
    "speed": { "type": "float", "label": "Velocidade", "slot": 0, "default": 0.6, "min": 0.0, "max": 3.0 },
    "scale": { "type": "float", "label": "Escala", "slot": 1, "default": 4.0, "min": 1.0, "max": 16.0 },
    "color_a": { "type": "color", "label": "Cor A", "slot": 2, "default": "#131a3a" },
    "color_b": { "type": "color", "label": "Cor B", "slot": 3, "default": "#4b6cff" }
  }
}

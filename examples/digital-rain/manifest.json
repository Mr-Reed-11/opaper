{
  "schema_version": 1,
  "name": "Digital Rain",
  "author": "opaper",
  "version": "0.1.0",
  "description": "Chuva digital estilo Matrix com caracteres caindo.",
  "type": "shader",
  "shader": "shader.frag",
  "params": {
    "speed": { "type": "float", "label": "Velocidade", "slot": 0, "default": 1.0, "min": 0.1, "max": 3.0 },
    "density": { "type": "float", "label": "Densidade", "slot": 1, "default": 24.0, "min": 10.0, "max": 50.0 },
    "glow": { "type": "float", "label": "Brilho", "slot": 2, "default": 1.2, "min": 0.0, "max": 3.0 },
    "fade_length": { "type": "float", "label": "Comprimento do rastro", "slot": 3, "default": 0.6, "min": 0.1, "max": 1.0 },
    "bg_color": { "type": "color", "label": "Fundo", "slot": 4, "default": "#000a00" },
    "rain_color": { "type": "color", "label": "Cor da chuva", "slot": 5, "default": "#00ff41" },
    "head_color": { "type": "color", "label": "Cor da ponta", "slot": 6, "default": "#aaffcc" },
    "accent": { "type": "color", "label": "Acento", "slot": 7, "default": "#004010" }
  }
}

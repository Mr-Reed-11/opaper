{
  "schema_version": 1,
  "name": "Geometric Pulse",
  "author": "opaper",
  "version": "0.1.0",
  "description": "Padroes geometricos pulsantes com ondas concentricas.",
  "type": "shader",
  "shader": "shader.frag",
  "params": {
    "speed": { "type": "float", "label": "Velocidade", "slot": 0, "default": 0.8, "min": 0.1, "max": 3.0 },
    "ring_count": { "type": "float", "label": "Aneis", "slot": 1, "default": 8.0, "min": 2.0, "max": 20.0 },
    "rotation_speed": { "type": "float", "label": "Rotacao", "slot": 2, "default": 0.3, "min": 0.0, "max": 2.0 },
    "pulse_intensity": { "type": "float", "label": "Intensidade do pulso", "slot": 3, "default": 1.0, "min": 0.0, "max": 2.0 },
    "bg_color": { "type": "color", "label": "Fundo", "slot": 4, "default": "#05050f" },
    "ring_color": { "type": "color", "label": "Cor dos aneis", "slot": 5, "default": "#4060ff" },
    "pulse_color": { "type": "color", "label": "Cor do pulso", "slot": 6, "default": "#ff4080" },
    "accent_color": { "type": "color", "label": "Acento", "slot": 7, "default": "#20ffcc" }
  }
}

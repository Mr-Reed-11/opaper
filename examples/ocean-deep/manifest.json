{
  "schema_version": 1,
  "name": "Ocean Deep",
  "author": "opaper",
  "version": "0.1.0",
  "description": "Oceano profundo com causticas de luz e particulas flutuantes.",
  "type": "shader",
  "shader": "shader.frag",
  "params": {
    "speed": { "type": "float", "label": "Velocidade", "slot": 0, "default": 0.5, "min": 0.0, "max": 2.0 },
    "caustic_scale": { "type": "float", "label": "Escala das causticas", "slot": 1, "default": 5.0, "min": 1.0, "max": 12.0 },
    "caustic_intensity": { "type": "float", "label": "Intensidade", "slot": 2, "default": 0.8, "min": 0.0, "max": 2.0 },
    "particle_count": { "type": "float", "label": "Particulas", "slot": 3, "default": 0.7, "min": 0.0, "max": 1.0 },
    "deep_color": { "type": "color", "label": "Profundidade", "slot": 4, "default": "#020a1a" },
    "mid_color": { "type": "color", "label": "Meio", "slot": 5, "default": "#0a3060" },
    "light_color": { "type": "color", "label": "Luz", "slot": 6, "default": "#40b0ff" },
    "caustic_color": { "type": "color", "label": "Causticas", "slot": 7, "default": "#60ddff" }
  }
}

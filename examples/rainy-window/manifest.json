{
  "schema_version": 1,
  "name": "Rainy Window",
  "author": "opaper",
  "version": "0.1.0",
  "description": "Vidro embaçado com gotas de chuva escorrendo.",
  "type": "shader",
  "shader": "shader.frag",
  "params": {
    "speed": { "type": "float", "label": "Velocidade", "slot": 0, "default": 0.7, "min": 0.1, "max": 2.0 },
    "drop_density": { "type": "float", "label": "Densidade de gotas", "slot": 1, "default": 4.0, "min": 1.0, "max": 8.0 },
    "blur_amount": { "type": "float", "label": "Desfoque", "slot": 2, "default": 0.6, "min": 0.0, "max": 1.0 },
    "trail_length": { "type": "float", "label": "Rastro", "slot": 3, "default": 0.7, "min": 0.0, "max": 1.0 },
    "bg_dark": { "type": "color", "label": "Fundo escuro", "slot": 4, "default": "#0c1420" },
    "bg_light": { "type": "color", "label": "Luzes de fundo", "slot": 5, "default": "#1a3050" },
    "drop_color": { "type": "color", "label": "Cor das gotas", "slot": 6, "default": "#4488cc" },
    "bokeh_color": { "type": "color", "label": "Cor do bokeh", "slot": 7, "default": "#ffaa44" }
  }
}

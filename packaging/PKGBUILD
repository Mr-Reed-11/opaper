# Maintainer: Vítor Ornelas
pkgname=opaper
pkgver=0.1.0
pkgrel=1
pkgdesc="Animated shader wallpapers for Linux / Wayland"
arch=('x86_64')
url="https://github.com/Mr-Reed-11/opaper"
license=('MIT')
depends=(
    'wayland'
    'libxkbcommon'
    'dbus'
    'webkit2gtk-4.1'
    'libayatana-appindicator'
    'vulkan-icd-loader'
)
makedepends=(
    'rust'
    'cargo'
    'nodejs'
    'npm'
    'pkg-config'
    'wayland-protocols'
)
optdepends=(
    'qt6-shadertools: KDE Plasma wallpaper plugin (qsb compiler)'
)

build() {
    cd "$startdir/.."
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --manifest-path engine/Cargo.toml
    cd app && npm install && npm run build && cd ..
    cargo build --release --manifest-path app/src-tauri/Cargo.toml
}

package() {
    cd "$startdir/.."
    install -Dm755 "$srcdir/target/release/opaper-engine" "$pkgdir/usr/bin/opaper-engine"
    install -Dm755 "$srcdir/target/release/opaper"        "$pkgdir/usr/bin/opaper"
    install -Dm755 packaging/opaper-launch                 "$pkgdir/usr/bin/opaper-launch"

    install -Dm644 packaging/br.com.nortixcode.opaper.desktop \
        "$pkgdir/usr/share/applications/opaper.desktop"

    install -Dm644 app/src-tauri/icons/32x32.png      "$pkgdir/usr/share/icons/hicolor/32x32/apps/opaper.png"
    install -Dm644 app/src-tauri/icons/64x64.png      "$pkgdir/usr/share/icons/hicolor/64x64/apps/opaper.png"
    install -Dm644 app/src-tauri/icons/128x128.png    "$pkgdir/usr/share/icons/hicolor/128x128/apps/opaper.png"
    install -Dm644 app/src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/opaper.png"
    install -Dm644 app/src-tauri/icons/icon.png       "$pkgdir/usr/share/icons/hicolor/512x512/apps/opaper.png"

    for dir in examples/*/; do
        name=$(basename "$dir")
        install -Dm644 "$dir/manifest.json" "$pkgdir/usr/share/opaper/examples/$name/manifest.json"
        install -Dm644 "$dir/shader.frag"   "$pkgdir/usr/share/opaper/examples/$name/shader.frag"
    done
}
